<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- The whole external storage: ROMs live in /storage/emulated/0/ROMs (ES-DE) and
       the emulators read them there. The provider only grants read access through
       per-intent permissions, never broadly. -->
  <external-path name="external_files" path="." />
  <external-path name="external_root" path="/" />
</paths>
